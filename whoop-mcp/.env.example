# Public HTTPS origin of this server (port 443, no path). The connector URL is PUBLIC_URL + /mcp
PUBLIC_URL=https://your-host.example.com
# From https://developer-dashboard.whoop.com (keep the secret in your host's secret store)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Password you type on the consent/admin pages (12+ chars)
OWNER_PASSWORD=
# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Where the encrypted token file lives - must be on a persistent disk
DATA_FILE=./data/state.enc
# Set to true only if you want workout data (adds the read:workout scope)
WHOOP_INCLUDE_WORKOUTS=false
